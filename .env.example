# Copy to .env.local for local development. Never commit real secrets.

# Postgres connection string used by the running app (Supabase local:
# `pnpm exec supabase start` prints this). In production with Supabase, use the
# POOLED connection string (port 6543, transaction mode) — serverless
# functions open/close connections too often for a direct connection to scale.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# Only needed in production with a pooled DATABASE_URL: Prisma Migrate runs DDL,
# which PgBouncer's transaction-pooling mode doesn't reliably support — this
# must be the DIRECT (non-pooled, port 5432) connection string. Falls back to
# DATABASE_URL if unset, which is correct for local dev (no pooler there).
# DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# Base URL used to build short-link redirect URLs (tap.pk/xxxx in prod).
# Placeholder for local dev until a real domain is assigned.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# JWT signing secret for admin auth. Generate with: openssl rand -base64 32
JWT_SECRET="dev-only-change-me"

# Bootstrap admin (seed script only, not used at runtime)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-now"
